POSTGRES_DB=ofc_media
POSTGRES_USER=ofc
POSTGRES_PASSWORD=gere_com_openssl_rand_hex_32
OFC_INTERNAL_TOKEN=gere_com_openssl_rand_hex_32
OFC_SESSION_PEPPER=gere_com_openssl_rand_hex_32
OFC_PLAYBACK_TTL_SECONDS=43200
OFC_PUBLIC_PORT=5091
OFC_SYNC_INTERVAL=600
OFC_TRANSCODE_ENCODER=libx264
OFC_MAX_TRANSCODES=1
OFC_MAX_TRANSCODE_QUEUE=1
OFC_FFMPEG_LOG_TAIL_BYTES=65536
OFC_MAX_ACTIVE_TORRENTS=2
OFC_HLS_CACHE_GIB=250
OFC_GDRIVE_ROOT_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID
OFC_GDRIVE_SYNC_INTERVAL=300

# Fontes permanentes no Windows. Nao aponte estas variaveis para copias no WSL.
OFC_FILECR_DATA_DIR=/run/desktop/mnt/host/d/dev/Torrents/FileCR/data
OFC_1337X_DATA_DIR=/run/desktop/mnt/host/d/dev/Torrents/1337xVault/data
OFC_WEB_DATA_DIR=/run/desktop/mnt/host/d/dev/Torrents/FileCRWeb/data
OFC_SUBTITLE_DATA_DIR=/run/desktop/mnt/host/d/dev/Torrents/SubtitleVault/data
OFC_SUBTITLE_FILES_DIR=/run/desktop/mnt/host/d/dev/Torrents/SubtitleVault/subtitles
OFC_FILECR_TORRENT_DIR=/run/desktop/mnt/host/d/dev/Torrents/FileCR/torrents
OFC_1337X_TORRENT_DIR=/run/desktop/mnt/host/d/dev/Torrents/1337xVault/downloads
