.env.*
!.env.example
!.env.wsl.example
credentials.json
credentials.*.json
token.json
token.*.json
client_secret*.json

# Bancos vivos, metainfo e dados baixados
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
*.torrent
*.fastresume
data/
downloads/

# Dados operacionais da plataforma
